{
  "name": "@tplant/small-caps",
  "version": "0.1.0",
  "description": "Sets acronyms in note bodies in small caps",
  "type": "module",
  "license": "MIT",
  "author": "Tom Plant",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "scripts": {
    "build": "node ../build.mjs small-caps"
  },
  "engines": {
    "node": ">=22"
  },
  "quartz": {
    "name": "small-caps",
    "displayName": "Small Caps",
    "category": "transformer",
    "version": "1.0.0",
    "quartzVersion": ">=5.0.0",
    "dependencies": [],
    "defaultOrder": 95,
    "defaultEnabled": true,
    "defaultOptions": {}
  }
}

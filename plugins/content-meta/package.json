{
  "name": "@tplant/content-meta",
  "version": "0.1.0",
  "description": "The line under a page's title: date, size in words, reading time, history",
  "type": "module",
  "license": "MIT",
  "author": "Tom Plant",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "scripts": {
    "build": "node ../build.mjs content-meta"
  },
  "peerDependencies": {
    "preact": "^10.0.0"
  },
  "peerDependenciesMeta": {
    "preact": {
      "optional": false
    }
  },
  "engines": {
    "node": ">=22"
  },
  "quartz": {
    "name": "content-meta",
    "displayName": "Content Meta",
    "category": "component",
    "version": "1.0.0",
    "quartzVersion": ">=5.0.0",
    "dependencies": [],
    "defaultOrder": 50,
    "defaultEnabled": true,
    "defaultOptions": {
      "showReadingTime": true,
      "historyUrl": "https://github.com/pl4nty/garden/commits/main/"
    },
    "components": {
      "ContentMeta": {
        "displayName": "Content Meta",
        "defaultPosition": "beforeBody",
        "defaultPriority": 20
      }
    },
    "optionSchema": {
      "showReadingTime": {
        "type": "boolean"
      },
      "historyUrl": {
        "type": "string"
      }
    }
  }
}

{
  "name": "@tplant/footer",
  "version": "0.1.0",
  "description": "The footer line of a manual page (site, date, slug and section) and the site's links out",
  "type": "module",
  "license": "MIT",
  "author": "Tom Plant",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "scripts": {
    "build": "node ../build.mjs footer"
  },
  "peerDependencies": {
    "preact": "^10.0.0"
  },
  "peerDependenciesMeta": {
    "preact": {
      "optional": false
    }
  },
  "engines": {
    "node": ">=22"
  },
  "quartz": {
    "name": "footer",
    "displayName": "Footer",
    "category": "component",
    "version": "1.0.0",
    "quartzVersion": ">=5.0.0",
    "dependencies": [],
    "defaultOrder": 50,
    "defaultEnabled": true,
    "defaultOptions": {
      "site": "",
      "sections": {},
      "defaultSection": 7,
      "links": {}
    },
    "components": {
      "Footer": {
        "displayName": "Footer",
        "defaultPosition": "footer",
        "defaultPriority": 50
      }
    },
    "optionSchema": {
      "site": {
        "type": "string"
      },
      "sections": {
        "type": "object"
      },
      "defaultSection": {
        "type": "number"
      },
      "links": {
        "type": "object"
      }
    }
  }
}
